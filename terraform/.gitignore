# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfstate.lock.info

# Terraform working directories
**/.terraform/*

# Terraform plans
*.tfplan
*.plan

# Variable files that may contain secrets
*.tfvars
*.tfvars.json
!example.tfvars

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

